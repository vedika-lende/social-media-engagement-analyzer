/* Readability, contrast, and chart-layout improvements */
:root{--bg:#f3f6fb;--ink:#182844;--muted:#65748b;--line:#dfe6f0;}
body{font-size:15px;line-height:1.5;overflow-x:hidden;}
.main{width:calc(100% - 250px);max-width:none;min-width:0;padding:30px clamp(20px,3vw,46px) 24px;}
.sidebar{width:250px;}
.nav-label,.overline{font-size:11px;letter-spacing:1.4px;}
.nav-link{font-size:14px;padding:15px 14px;}
.topbar h1{font-size:clamp(27px,2.4vw,36px);letter-spacing:-.7px;}
.breadcrumb,.intro{font-size:14px;}
.welcome-strip{min-height:142px;padding:28px 30px;}
.welcome-strip h2{font-size:clamp(21px,2vw,27px);line-height:1.3;}
.welcome-strip p{font-size:14px;line-height:1.6;}
.upload-info h3{font-size:15px;}
.upload-info p,.notice{font-size:13px;}
.file-pick,.btn{font-size:13px;padding:12px 15px;}
.metric-grid{gap:16px;}
.metric-card{padding:21px 22px;}
.metric-top{font-size:13px;}
.metric-number{font-size:clamp(27px,2.2vw,34px);}
.metric-foot{font-size:12px;color:#718098;}
.panel{padding:24px;overflow:hidden;}
.panel-heading h2{font-size:20px;line-height:1.35;}
.panel-heading p{font-size:13px;line-height:1.5;}
.settings label{font-size:13px;}
.settings small{font-size:12px;}
.feature-option{font-size:12px;padding:9px 10px;}
.charts-grid{grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);align-items:stretch;gap:18px;}
.chart-panel{min-width:0;max-width:100%;overflow:hidden;}
.chart{height:360px;min-height:360px;width:100%;min-width:0;position:relative;overflow:hidden;}
.chart.empty{height:360px;min-height:360px;font-size:13px;text-align:center;padding:20px;}
.chart .js-plotly-plot,.chart .plot-container,.chart .svg-container{width:100%!important;max-width:100%!important;}
.table-scroll{max-width:100%;border:1px solid #e7ecf3;border-radius:10px;}
table{font-size:13px;}th{font-size:11px;}td,th{padding:13px 15px;}
.cluster-pill{font-size:12px;}
.data-tag{font-size:12px;}
footer{font-size:12px;}
@media(max-width:1200px){.main{width:calc(100% - 215px)}.sidebar{width:215px}.charts-grid{grid-template-columns:minmax(0,1fr)}.chart{height:350px;min-height:350px}}
@media(max-width:760px){.sidebar{width:auto}.main{width:100%;margin:0;padding:20px 14px}.charts-grid{grid-template-columns:minmax(0,1fr)}.chart,.chart.empty{height:320px;min-height:320px}.topbar h1{font-size:27px}.welcome-strip h2{font-size:20px}.metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.panel{padding:17px}.panel-heading h2{font-size:18px}footer{font-size:11px}}
